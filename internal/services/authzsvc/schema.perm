entity user {}

entity organization {
    relation owner @user
    relation admin @user
    relation member @user

    permission manage = owner or admin
    permission view = manage or member
}

entity orgUnit {
    relation parentOrg @organization
    relation parent @orgUnit
    relation member @user
    relation admin @user

    permission manage = admin or parent.manage or parentOrg.manage
    permission view = manage or member or parent.view
}

entity resourceGroup {
    relation parentOrg  @organization
    relation creator    @orgUnit
    relation viewer     @orgUnit
    relation editor     @orgUnit
    relation deleter    @orgUnit

    permission view   = creator or viewer or editor or deleter or parentOrg.manage
    permission edit   = editor or parentOrg.manage
    permission delete = deleter or parentOrg.manage
    permission create = creator or parentOrg.manage
}

entity resource {
    relation parentOrg    @organization
    relation parentGroup  @resourceGroup
    relation directViewer @orgUnit
    relation creator      @user

    permission view   = parentGroup.view or directViewer or creator or parentOrg.manage
    permission edit   = parentGroup.edit or parentOrg.manage
    permission delete = parentGroup.delete or parentOrg.manage
}

entity menu {
    relation parentOrg @organization
    relation viewer @orgUnit
    relation viewerUser @user

    permission view = viewer.view or viewerUser or parentOrg.manage
}

entity serviceAccount {
    relation parentOrg @organization
    relation scopeUnit @orgUnit

    permission act = scopeUnit.manage or parentOrg.manage
    permission use = act
}

entity workspace {
    relation owner @user
    relation org   @organization

    permission manage = owner or org.manage
    permission view   = manage or org.view
}
