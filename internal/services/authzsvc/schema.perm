entity user {}

entity organization {
    relation admin @user
    relation member @user

    permission manage = admin
    permission view = manage or member
}

entity orgUnit {
    relation parentOrg @organization
    relation parent @orgUnit
    relation member @user
    relation admin @user

    permission manage = admin or parent.manage or parentOrg.manage
    permission view = manage or member or parent.view
}

entity deviceGroup {
    relation parentOrg @organization
    relation viewer @orgUnit
    relation editor @orgUnit
    relation deleter @orgUnit

    permission view = viewer.view or editor.view or deleter.view or parentOrg.manage
    permission edit = editor.view or parentOrg.manage
    permission delete = deleter.view or parentOrg.manage
    permission createDevice = editor.view or parentOrg.manage
}

entity device {
    relation parentOrg @organization
    relation parentGroup @deviceGroup
    relation creator @user

    permission view = parentGroup.view or creator or parentOrg.manage
    permission edit = parentGroup.edit or parentOrg.manage
    permission delete = parentGroup.delete or parentOrg.manage
}

entity menu {
    relation parentOrg @organization
    relation viewer @orgUnit
    relation viewerUser @user

    permission view = viewer.view or viewerUser or parentOrg.manage
}

entity serviceAccount {
    relation parentOrg @organization
    relation scopeUnit @orgUnit

    permission act = scopeUnit.manage or parentOrg.manage
    permission use = act
}