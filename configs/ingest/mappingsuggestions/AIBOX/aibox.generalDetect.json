    { "sourceField": "eventAttribute.upperColor",           "targetField": "eventAttribute.upperColor" },
    { "sourceField": "eventAttribute.lower",                "targetField": "eventAttribute.lower" },
    { "sourceField": "eventAttribute.lowerColor",           "targetField": "eventAttribute.lowerColor" },
    { "sourceField": "eventAttribute.skirt",                "targetField": "eventAttribute.skirt" },
