    { "sourceField": "eventAttribute.vestName",             "targetField": "eventAttribute.vestName" },
    { "sourceField": "eventAttribute.vestListType",         "targetField": "eventAttribute.vestListType" },
    { "sourceField": "eventAttribute.vestSimilarity",       "targetField": "eventAttribute.vestSimilarity" },
