    {
      "name": "03 — Group Members (Devices in Group)",
      "description": "Manage devices within a resource group.\nList cameras in group, bulk add, bulk remove.\nPath: /resources/groups/:groupId/:resource",
      "item": [
        {
          "name": "GET /resources/groups/:groupId/camera — List cameras in group",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{urlapi}}/resources/groups/{{groupId}}/camera?page=1&perPages=10&sortField=createAt&sortOrder=desc",
              "host": ["{{urlapi}}"],
              "path": ["resources", "groups", "{{groupId}}", "camera"],
              "query": [
                { "key": "search",    "value": "",          "description": "Search by name",          "disabled": true },
                { "key": "page",      "value": "1",         "description": "Page number (default 1)" },
                { "key": "perPages",  "value": "10",        "description": "Items per page (default 10)" },
                { "key": "sortField", "value": "createAt",  "description": "Sort field (default createAt)" },
                { "key": "sortOrder", "value": "desc",      "description": "Sort order: asc | desc" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Active-Org",  "value": "{{orgId}}" }
            ],
            "description": "List cameras that belong to a specific resource group.\nMerges MongoDB camera metadata with group membership."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Response has cameras list', () => {",
                  "    pm.expect(json).to.have.property('code', 'SUCCESS');",
                  "    pm.expect(json).to.have.property('status', true);",
                  "    pm.expect(json).to.have.property('details');",
                  "    pm.expect(json).to.have.property('pagination');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /resources/groups/:groupId/camera — Bulk add cameras",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{urlapi}}/resources/groups/{{groupId}}/camera",
              "host": ["{{urlapi}}"],
              "path": ["resources", "groups", "{{groupId}}", "camera"]
            },
            "header": [
              { "key": "Content-Type",  "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "X-Active-Org",  "value": "{{orgId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"camera\": [\n    { \"camId\": \"{{cameraId}}\" }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "Bulk add cameras to a resource group.\n\nBody key must match the :resource path param (e.g. \"camera\").\nEach item needs a \"camId\" field.\n\nResponse details array shows per-device success/error status."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('Bulk add result', () => {",
                  "    pm.expect(json).to.have.property('code', 'SUCCESS');",
                  "    pm.expect(json).to.have.property('status', true);",
                  "    pm.expect(json).to.have.property('details');",
                  "});"
                ]
              }
            }
          ]
        },
